# Compose uses internal development credentials. Keep hosted secrets in the platform environment.
INQUEST_API_PORT=8000
INQUEST_DB_PORT=5434

# Optional live model. The database kill switch defaults to off.
# INQUEST_GROQ_API_KEY=
# Set a stable, random HMAC secret when running outside a local demo.
# INQUEST_IP_HASH_SECRET=

# Browser origin used for OAuth redirects and cookie-authenticated writes.
INQUEST_WEB_PORT=5173
INQUEST_WEB_ORIGIN=http://localhost:5173
# GitHub OAuth app callback: http://localhost:5173/api/v1/auth/github/callback
INQUEST_GITHUB_CLIENT_ID=
INQUEST_GITHUB_CLIENT_SECRET=
# Google Web application redirect: http://localhost:5173/api/v1/auth/google/callback
INQUEST_GOOGLE_CLIENT_ID=
INQUEST_GOOGLE_CLIENT_SECRET=
